{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/treinamentos/hook.mjs\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Conferindo a Central de treinamentos"
          }
        ]
      }
    ]
  }
}
