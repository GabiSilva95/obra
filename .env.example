# ConstruktPro: variáveis de ambiente. Copie para .env e preencha. Na Vercel, defina as mesmas em Production E em Preview.
# Nunca coloque valores reais neste arquivo.

# ── Banco (Neon) ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host.neon.tech/neondb?sslmode=require"

# ── Autenticação ──────────────────────────────────────────────────────────────
JWT_SECRET="um-segredo-longo-e-aleatorio"
# JWT_SECRET_EQUIPE=""        # opcional: chave própria dos tokens da equipe (sem ela, deriva do JWT_SECRET)
# DEMO_SENHA=""               # senha da conta interna de testes (admin@teste.com), usada por seed, gravação e testes

# ── Endereços ─────────────────────────────────────────────────────────────────
# APP_URL="https://seu-dominio"            # links nos e-mails e retornos do pagamento (sem barra no fim)
# PAINEL_HOST="painel.seu-dominio"         # com ele, /api/painel só responde nesse host
# FRONTEND_URL=""                          # CORS / alternativa ao APP_URL

# ── E-mail do chamado (Resend) ────────────────────────────────────────────────
# EMAIL_PROVIDER="resend"                  # qualquer outro valor (ou vazio) desliga o e-mail
# RESEND_API_KEY="re_..."
# EMAIL_REMETENTE="ConstruktPro Suporte <suporte@seu-dominio>"   # domínio verificado no Resend
# EMAIL_RECEBIMENTO_DOMINIO="xxxxxxxx.resend.app"                # onde chegam as respostas (o do Resend, ou um seu com MX)
# RESEND_WEBHOOK_SECRET="whsec_..."        # do webhook email.received -> https://seu-dominio/api/email/webhook/resend
# EMAIL_SEGREDO=""                         # opcional: chave dos endereços de resposta (sem ela, deriva do JWT_SECRET)

# ── Pagamento (gateway) ───────────────────────────────────────────────────────
# PAGAMENTO_GATEWAY="stripe"               # padrão: manual (a equipe registra o pagamento no painel)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."        # do endpoint https://seu-dominio/api/pagamentos/webhook/stripe

# ── Só para teste e desenvolvimento (ignoradas em produção) ───────────────────
# PAGAMENTO_WEBHOOK_SEGREDO=""             # gateway de mentira usado nos testes
# RESEND_API_BASE=""                       # aponta o Resend para um servidor de mentira nos testes
# STRIPE_API_BASE=""                       # aponta o Stripe para um servidor de mentira nos testes
# SUPORTE_HORARIO_TESTE="sempre"           # fixa o horário do chat (sempre | nunca)
# API_RATE_LIMIT=""                        # sobe o limite de requisições da API de teste
