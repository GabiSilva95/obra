generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  razaoSocial String
  cnpj        String   @unique
  email       String   @unique
  plano       String   @default("starter")
  createdAt   DateTime @default(now())

  // Conta e assinatura (painel interno da equipe). `ativo` por padrão: clientes antigos e a conta interna não mudam.
  status               String    @default("ativo") // trial | ativo | inadimplente | suspenso | cancelado
  trialAte             String? // AAAA-MM-DD, fuso de São Paulo
  ciclo                String    @default("mensal") // mensal | anual
  ultimoAcessoEm       DateTime?
  motivoStatus         String?
  notasInternas        String?
  // Contato e aceite de mensagens e notificações do serviço, registrados no cadastro
  telefone             String? // só dígitos com 55: 5511999990000
  aceiteMensagensEm    DateTime?
  aceiteMensagensTexto String?
  aceiteMensagensIp    String?

  users               User[]
  obras               Obra[]
  tiposEtapa          TipoEtapa[]
  maquinas            Maquina[]
  funcionarios        Funcionario[]
  insumos             Insumo[]
  etapasObra          EtapaObra[]
  estoques            Estoque[]
  alocacoes           Alocacao[]
  diarios             DiarioObra[]
  receitas            Receita[]
  ordensCompra        OrdemCompra[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  // Novos (Melhorias 1 e 2)
  categoriasMaquina   CategoriaMaquina[]
  tiposObra           TipoObra[]
  // Novos (Prioridades 4 a 8)
  consumos            ConsumoInsumo[]
  apontamentos        ApontamentoMO[]
  despesas            Despesa[]
  anexos              Anexo[]
  subetapas           Subetapa[]
  itensOrdem          ItemOrdemCompra[]
  transferencias      Transferencia[]
  // Financeiro (títulos, contas, rateio, conciliação)
  contasFinanceiras   ContaFinanceira[]
  categoriasFinanc    CategoriaFinanceira[]
  centrosCusto        CentroCusto[]
  titulos             Titulo[]
  titulosRateio       TituloRateio[]
  baixas              Baixa[]
  lancamentosBanc     LancamentoBancario[]
  importacoesExtrato  ImportacaoExtrato[]
  transferenciasConta TransferenciaConta[]
  configFinanceira    ConfigFinanceira?
  // Suporte (chamados e chat)
  tickets             Ticket[]
  // Assinatura e cobranças (painel da equipe)
  assinatura          Assinatura?
  cobrancas           Cobranca[]
}

// ─── Usuários e Acessos ───────────────────────────────────────────────────────

model User {
  id          Int      @id @default(autoincrement())
  tenantId    String
  nome        String
  email       String
  senha       String
  role        String   @default("user")
  ativo       Boolean  @default(true)
  permissoes  String[] @default([])
  // Tour de primeiros passos: true quando o usuário marca "Não mostrar novamente"
  ocultarTour Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obrasAcesso    ObraAcesso[]
  refreshTokens  RefreshToken[]
  ticketsAbertos Ticket[]

  @@unique([tenantId, email])
}

model ObraAcesso {
  userId Int
  obraId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@id([userId, obraId])
}

// ─── Obras ────────────────────────────────────────────────────────────────────

model Obra {
  id          Int      @id @default(autoincrement())
  tenantId    String
  nome        String
  local       String
  responsavel String?
  inicio      String
  previsaoFim String
  orcamento   Float    @default(0)
  status      String   @default("Planejada")
  descricao   String?
  createdAt   DateTime @default(now())
  // Melhoria 2: tipo de obra (nullable para compatibilidade com obras existentes)
  tipoObraId  Int?

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoObra              TipoObra?         @relation(fields: [tipoObraId], references: [id], onDelete: SetNull)
  etapas                EtapaObra[]
  estoques              Estoque[]
  alocacoes             Alocacao[]
  funcionarioObra       FuncionarioObra[]
  acessos               ObraAcesso[]
  diario                DiarioObra[]
  receitas              Receita[]
  ordensCompra          OrdemCompra[]
  consumos              ConsumoInsumo[]
  apontamentos          ApontamentoMO[]
  despesas              Despesa[]
  anexos                Anexo[]
  rateiosTitulo         TituloRateio[]
  transferenciasOrigem  Transferencia[]   @relation("TransferenciaOrigem")
  transferenciasDestino Transferencia[]   @relation("TransferenciaDestino")

  @@index([tenantId])
  @@index([tipoObraId])
}

// ─── Anexos da Obra ──────────────────────────────────────────────────────────

/// Arquivos anexados a uma obra: projetos, plantas, orçamentos, fotos.
///
/// O conteúdo é guardado no próprio banco (bytea) porque o projeto não tem
/// storage de objetos configurado. Isso limita o tamanho por arquivo — ver
/// LIMITE_ANEXO em server/routes/anexos.js. Migrar para storage externo
/// depois exige trocar apenas `dados` por uma URL.
model Anexo {
  id        Int      @id @default(autoincrement())
  tenantId  String
  obraId    Int
  nome      String
  mimeType  String
  tamanho   Int
  dados     Bytes
  descricao String?
  userId    Int?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([obraId])
}

// ─── Tipos de Etapa ───────────────────────────────────────────────────────────

model TipoEtapa {
  id          Int     @id @default(autoincrement())
  tenantId    String
  nome        String
  icon        String?
  tempoPadrao Int?
  // Melhoria 3: ordem para exibição na biblioteca padrão
  ordem       Int?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etapas         EtapaObra[]
  tiposObraEtapa TipoObraEtapa[]

  @@index([tenantId])
}

model EtapaObra {
  id          Int     @id @default(autoincrement())
  tenantId    String  @default("")
  obraId      Int
  tipoEtapaId Int
  dataInicioP String
  dataFimP    String
  dataInicioR String?
  dataFimR    String?
  status      String  @default("Pendente")
  progresso   Int     @default(0)
  orcamento   Float   @default(0)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra      Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tipoEtapa TipoEtapa @relation(fields: [tipoEtapaId], references: [id])

  // Prioridade 7: custo realizado por etapa
  alocacoes     Alocacao[]
  consumos      ConsumoInsumo[]
  apontamentos  ApontamentoMO[]
  despesas      Despesa[]
  ordensCompra  OrdemCompra[]
  subetapas     Subetapa[]
  rateiosTitulo TituloRateio[]

  @@index([tenantId])
  @@index([obraId])
}

// ─── Tipos de Obra (Melhoria 2) ───────────────────────────────────────────────

model TipoObra {
  id        Int     @id @default(autoincrement())
  tenantId  String
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obras  Obra[]
  etapas TipoObraEtapa[]

  @@index([tenantId])
}

/// Vínculo N:N entre TipoObra e TipoEtapa com ordenação
model TipoObraEtapa {
  id          Int @id @default(autoincrement())
  tipoObraId  Int
  tipoEtapaId Int
  ordem       Int @default(0)

  tipoObra  TipoObra  @relation(fields: [tipoObraId], references: [id], onDelete: Cascade)
  tipoEtapa TipoEtapa @relation(fields: [tipoEtapaId], references: [id], onDelete: Cascade)

  @@unique([tipoObraId, tipoEtapaId])
  @@index([tipoObraId])
}

// ─── Máquinas e Equipamentos (Melhoria 1) ────────────────────────────────────

/// Categorias de equipamentos (ex: Escavadeira, Betoneira…)
model CategoriaMaquina {
  id       Int     @id @default(autoincrement())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maquinas Maquina[]

  @@index([tenantId])
}

model Maquina {
  id        Int     @id @default(autoincrement())
  tenantId  String
  nome      String
  // Campo legado mantido — agora preenchido como texto livre OU substituído por categoriaId
  tipo      String?
  modelo    String?
  // Custo efetivo por hora — fonte de verdade para calcMaq.
  // Calculado automaticamente pelo frontend conforme tipoPropriedade.
  custoHora Float   @default(0)

  // Melhoria 1: categoria via FK
  categoriaId Int?

  // Melhoria 1: tipo de propriedade
  tipoPropriedade String? // "propria" | "alugada"

  // Campos para máquina alugada
  tipoCobranca String? // "hora" | "mensal"
  valorLocacao Float? // valor/hora ou valor/mês conforme tipoCobranca

  // Campos para máquina própria
  valorAquisicao Float?
  dataAquisicao  String?
  vidaUtilAnos   Int?
  horasProdMes   Int?

  // Financeiro: quem recebe o aluguel (pessoa com perfil fornecedor)
  locadorId Int?

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria CategoriaMaquina? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  locador   Funcionario?      @relation(fields: [locadorId], references: [id], onDelete: SetNull)
  alocacoes Alocacao[]

  @@index([tenantId])
  @@index([categoriaId])
}

// ─── Funcionários ─────────────────────────────────────────────────────────────

model Funcionario {
  id            Int     @id @default(autoincrement())
  tenantId      String
  nome          String
  cpfCnpj       String?
  telefone      String?
  email         String?
  endereco      String?
  isColaborador Boolean @default(false)
  isFornecedor  Boolean @default(false)
  isCliente     Boolean @default(false)
  cargo         String?
  salarioDia    Float   @default(0)
  ativo         Boolean @default(true)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  funcionarioObra FuncionarioObra[]
  apontamentos    ApontamentoMO[]
  ordensCompra    OrdemCompra[]
  titulos         Titulo[]
  maquinasLocadas Maquina[]
}

model Subetapa {
  id          Int     @id @default(autoincrement())
  etapaId     Int
  tenantId    String
  nome        String
  concluida   Boolean @default(false)
  dataInicioP String?
  dataFimP    String?
  dataInicioR String?
  dataFimR    String?

  etapa  EtapaObra @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([etapaId])
  @@index([tenantId])
}

model FuncionarioObra {
  id            Int @id @default(autoincrement())
  funcionarioId Int
  obraId        Int
  dias          Int @default(0)

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  obra        Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

// ─── Insumos ──────────────────────────────────────────────────────────────────

model Insumo {
  id         Int     @id @default(autoincrement())
  tenantId   String
  nome       String
  unidade    String
  custoUnit  Float   @default(0)
  categoria  String?
  fornecedor String?

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estoques       Estoque[]
  alocacoes      Alocacao[]
  ordensCompra   OrdemCompra[]
  consumoInsumos ConsumoInsumo[]
  itensOrdem     ItemOrdemCompra[]
  transferencias Transferencia[]
}

// ─── Estoque ──────────────────────────────────────────────────────────────────

model Estoque {
  id             Int      @id @default(autoincrement())
  tenantId       String   @default("")
  obraId         Int
  insumoId       Int
  quantEntrada   Float    @default(0)
  quantUtilizado Float    @default(0)
  custoUnit      Float    @default(0)
  dataMov        String
  origem         String?
  createdAt      DateTime @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra     Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  insumo   Insumo          @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  consumos ConsumoInsumo[]

  @@index([tenantId])
  @@index([obraId])
}

// ─── Consumo de Insumo (Prioridades 4 e 8) ───────────────────────────────────

/// Baixa de estoque como lançamento próprio: tem data, custo congelado e etapa.
/// Substitui o acúmulo cego em Estoque.quantUtilizado, que continua sendo
/// mantido pelo backend como saldo derivado para as telas de disponibilidade.
model ConsumoInsumo {
  id            Int      @id @default(autoincrement())
  tenantId      String
  obraId        Int
  estoqueId     Int
  insumoId      Int
  etapaId       Int?
  quantidade    Float    @default(0)
  /// Snapshot do custo unitário na data da baixa — reajustar o insumo
  /// depois não reescreve o custo já apropriado.
  custoUnitario Float    @default(0)
  data          String
  obs           String?
  createdAt     DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra    Obra       @relation(fields: [obraId], references: [id], onDelete: Cascade)
  estoque Estoque    @relation(fields: [estoqueId], references: [id], onDelete: Cascade)
  insumo  Insumo     @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  etapa   EtapaObra? @relation(fields: [etapaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([obraId])
  @@index([estoqueId])
  @@index([etapaId])
}

// ─── Apontamento de Mão de Obra (Prioridade 5) ───────────────────────────────

/// Presença diária por pessoa e obra, com valor/dia congelado.
/// A chave única impede o mesmo dia ser lançado duas vezes — a duplicação
/// silenciosa de custo que o vínculo acumulado permitia.
model ApontamentoMO {
  id            Int      @id @default(autoincrement())
  tenantId      String
  obraId        Int
  funcionarioId Int
  etapaId       Int?
  data          String
  /// Fração do dia: 1 = dia cheio, 0.5 = meio período
  dias          Float    @default(1)
  /// Snapshot do valor/dia da pessoa na data do apontamento
  valorDia      Float    @default(0)
  /// Registro do diário que originou este apontamento, quando houver
  diarioId      Int?
  obs           String?
  /// Título a pagar que quitou esta diária (nulo = ainda não paga)
  tituloId      Int?
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra        Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  etapa       EtapaObra?  @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  diarioRef   DiarioObra? @relation(fields: [diarioId], references: [id], onDelete: SetNull)
  titulo      Titulo?     @relation(fields: [tituloId], references: [id], onDelete: SetNull)

  @@unique([funcionarioId, obraId, data])
  @@index([tenantId])
  @@index([obraId])
  @@index([etapaId])
}

// ─── Despesas (Prioridade 6) ─────────────────────────────────────────────────

/// Custos que não são material, máquina nem mão de obra: combustível,
/// manutenção, aluguel, tributos, administrativo.
/// obraId nulo = despesa geral da empresa, fora do custo de uma obra.
model Despesa {
  id            Int      @id @default(autoincrement())
  tenantId      String
  obraId        Int?
  etapaId       Int?
  categoria     String
  descricao     String
  valor         Float    @default(0)
  data          String
  fornecedor    String?
  obs           String?
  createdAt     DateTime @default(now())
  // Financeiro: centro de custo e documento (grupo) que liga as linhas de um rateio ao título
  centroCustoId Int?
  grupoId       String?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra        Obra?        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  etapa       EtapaObra?   @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  centroCusto CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([obraId])
  @@index([etapaId])
  @@index([grupoId])
}

// ─── Alocação ─────────────────────────────────────────────────────────────────

model Alocacao {
  id            Int     @id @default(autoincrement())
  tenantId      String  @default("")
  obraId        Int
  tipo          String
  maquinaId     Int?
  insumoId      Int?
  quantidade    Float   @default(0)
  data          String
  obs           String?
  // Melhoria 1: custo snapshot no momento da alocação.
  // - Máquina própria / alugada hora: quantidade × custoHora (calculado pelo backend)
  // - Máquina alugada mensal: valorLocacao (custo fixo, independe das horas)
  // Nullable para compatibilidade com alocações anteriores (fallback em calcMaq).
  custoUnitario Float?

  // Prioridade 7: apropriação por etapa
  etapaId  Int?
  // Financeiro: título a pagar (locação) que quitou esta alocação
  tituloId Int?

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra    Obra       @relation(fields: [obraId], references: [id], onDelete: Cascade)
  maquina Maquina?   @relation(fields: [maquinaId], references: [id])
  insumo  Insumo?    @relation(fields: [insumoId], references: [id])
  etapa   EtapaObra? @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  titulo  Titulo?    @relation(fields: [tituloId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([obraId])
  @@index([etapaId])
}

// ─── Diário de Obra ───────────────────────────────────────────────────────────

model DiarioObra {
  id            Int      @id @default(autoincrement())
  tenantId      String   @default("")
  obraId        Int
  data          String
  clima         String?
  descricao     String
  trabalhadores Int      @default(0)
  obs           String?
  createdAt     DateTime @default(now())

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra         Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  apontamentos ApontamentoMO[]

  @@index([tenantId])
  @@index([obraId])
}

// ─── Receitas ─────────────────────────────────────────────────────────────────

model Receita {
  id            Int     @id @default(autoincrement())
  tenantId      String  @default("")
  // Opcional: a receita de um centro de custo (ex.: venda de sucata) não tem obra
  obraId        Int?
  descricao     String
  valor         Float   @default(0)
  data          String
  tipo          String  @default("Contrato")
  // Financeiro: centro de custo e documento (grupo) que liga as linhas de um rateio ao título
  centroCustoId Int?
  grupoId       String?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra        Obra?        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  centroCusto CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([obraId])
  @@index([grupoId])
}

// ─── Ordens de Compra ─────────────────────────────────────────────────────────

model OrdemCompra {
  id           Int     @id @default(autoincrement())
  numero       Int?
  tenantId     String  @default("")
  obraId       Int
  // Campos legados (OCs antigas single-item) — novos registros usam ItemOrdemCompra
  insumoId     Int?
  descricao    String  @default("")
  quantidade   Float   @default(0)
  valorUnit    Float   @default(0)
  fornecedor   String?
  fornecedorId Int?
  status       String  @default("Pendente")
  data         String
  obs          String?
  etapaId      Int?

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obra             Obra              @relation(fields: [obraId], references: [id], onDelete: Cascade)
  insumo           Insumo?           @relation(fields: [insumoId], references: [id])
  etapa            EtapaObra?        @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  fornecedorPessoa Funcionario?      @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  itens            ItemOrdemCompra[]

  @@index([tenantId])
  @@index([obraId])
  @@index([etapaId])
  @@index([fornecedorId])
}

model ItemOrdemCompra {
  id         Int     @id @default(autoincrement())
  ordemId    Int
  tenantId   String  @default("")
  insumoId   Int?
  descricao  String?
  quantidade Float   @default(0)
  valorUnit  Float   @default(0)

  ordem  OrdemCompra @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  insumo Insumo?     @relation(fields: [insumoId], references: [id])

  @@index([ordemId])
  @@index([tenantId])
}

// ─── Transferência entre obras ───────────────────────────────────────────────

model Transferencia {
  id         Int      @id @default(autoincrement())
  tenantId   String
  deObraId   Int
  paraObraId Int
  insumoId   Int
  quantidade Float    @default(0)
  data       String
  obs        String?
  createdAt  DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deObra   Obra   @relation("TransferenciaOrigem", fields: [deObraId], references: [id], onDelete: Cascade)
  paraObra Obra   @relation("TransferenciaDestino", fields: [paraObraId], references: [id], onDelete: Cascade)
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([deObraId])
  @@index([paraObraId])
}

// ─── Segurança ────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revogado  Boolean  @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  tenantId  String
  userId    Int?
  metodo    String
  rota      String
  status    Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

// ─── Financeiro: contas, títulos, rateio e conciliação ───────────────────────
//
// Camada de CAIXA. O custo da obra (competência) continua em Despesa, Receita,
// ConsumoInsumo, Alocacao e ApontamentoMO; o título só diz quando e como se paga.
// Valores em Decimal(14,2): parcelas, rateios e baixas parciais não toleram Float.
// Datas seguem o resto do sistema: String AAAA-MM-DD (horário de São Paulo).

model ContaFinanceira {
  id               Int      @id @default(autoincrement())
  tenantId         String
  nome             String
  /// "banco" | "caixa"
  tipo             String   @default("banco")
  banco            String?
  agencia          String?
  numero           String?
  saldoInicial     Decimal  @default(0) @db.Decimal(14, 2)
  dataSaldoInicial String
  ativa            Boolean  @default(true)
  createdAt        DateTime @default(now())

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baixas                Baixa[]
  lancamentos           LancamentoBancario[]
  importacoes           ImportacaoExtrato[]
  transferenciasSaida   TransferenciaConta[] @relation("TransferenciaContaOrigem")
  transferenciasEntrada TransferenciaConta[] @relation("TransferenciaContaDestino")

  @@index([tenantId])
}

model CategoriaFinanceira {
  id       Int     @id @default(autoincrement())
  tenantId String
  /// "pagar" | "receber"
  tipo     String
  nome     String
  ativa    Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo, nome])
}

/// Dimensão analítica além de obra e etapa: Administrativo, Frota, Comercial…
model CentroCusto {
  id       Int     @id @default(autoincrement())
  tenantId String
  nome     String
  codigo   String?
  ativo    Boolean @default(true)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  despesas Despesa[]
  receitas Receita[]
  rateios  TituloRateio[]

  @@unique([tenantId, nome])
}

model ConfigFinanceira {
  tenantId        String @id
  prazoPadraoDias Int    @default(30)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Uma parcela a pagar ou a receber. `grupoId` liga as parcelas do mesmo documento
/// (e as linhas de Despesa/Receita geradas junto).
model Titulo {
  id            Int      @id @default(autoincrement())
  tenantId      String
  /// "pagar" | "receber"
  tipo          String
  pessoaId      Int?
  /// Nome livre quando a pessoa não está cadastrada
  pessoaTexto   String?
  descricao     String
  documento     String?
  categoria     String?
  valor         Decimal  @db.Decimal(14, 2)
  emissao       String
  vencimento    String
  parcela       Int      @default(1)
  totalParcelas Int      @default(1)
  grupoId       String
  /// "aberto" | "parcial" | "quitado" | "cancelado"; "vencido" é derivado pela data
  status        String   @default("aberto")
  /// "despesa" | "receita" | "compra" | "mao_de_obra" | "locacao" | "avulso"
  origemTipo    String   @default("avulso")
  origemId      Int?
  /// Conta fixa repetida: cada parcela é um custo do seu mês (e não uma divisão do valor)
  recorrente    Boolean  @default(false)
  obs           String?
  createdAt     DateTime @default(now())

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pessoa       Funcionario?    @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  rateios      TituloRateio[]
  baixas       Baixa[]
  apontamentos ApontamentoMO[]
  alocacoes    Alocacao[]

  /// Geração automática idempotente (ex.: a mesma compra entregue duas vezes)
  @@unique([tenantId, origemTipo, origemId, parcela])
  @@index([tenantId, tipo, status, vencimento])
  @@index([grupoId])
  @@index([pessoaId])
}

/// Como o título se divide entre obra, etapa e centro de custo. A soma é o valor do título.
model TituloRateio {
  id            Int     @id @default(autoincrement())
  tenantId      String
  tituloId      Int
  obraId        Int?
  etapaId       Int?
  centroCustoId Int?
  valor         Decimal @db.Decimal(14, 2)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  titulo      Titulo       @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  obra        Obra?        @relation(fields: [obraId], references: [id], onDelete: SetNull)
  etapa       EtapaObra?   @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  centroCusto CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tituloId])
  @@index([obraId])
  @@index([centroCustoId])
}

/// Pagamento ou recebimento de (parte de) um título.
/// `valor` quita o título; o dinheiro que se move é valor + juros + multa - desconto.
model Baixa {
  id           Int      @id @default(autoincrement())
  tenantId     String
  tituloId     Int
  contaId      Int
  data         String
  valor        Decimal  @db.Decimal(14, 2)
  juros        Decimal  @default(0) @db.Decimal(14, 2)
  multa        Decimal  @default(0) @db.Decimal(14, 2)
  desconto     Decimal  @default(0) @db.Decimal(14, 2)
  /// "pix" | "boleto" | "ted" | "dinheiro" | "cartao" | "cheque"
  forma        String   @default("pix")
  obs          String?
  /// Data do estorno; baixa estornada não conta no saldo nem no título
  estornadaEm  String?
  lancamentoId Int?
  createdAt    DateTime @default(now())

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  titulo     Titulo              @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  conta      ContaFinanceira     @relation(fields: [contaId], references: [id])
  lancamento LancamentoBancario? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tituloId])
  @@index([contaId])
  @@index([lancamentoId])
}

/// Arquivo de extrato importado (OFX ou CSV).
model ImportacaoExtrato {
  id             Int      @id @default(autoincrement())
  tenantId       String
  contaId        Int
  arquivo        String
  formato        String
  periodoInicio  String?
  periodoFim     String?
  saldoFinal     Decimal? @db.Decimal(14, 2)
  dataSaldoFinal String?
  total          Int      @default(0)
  novos          Int      @default(0)
  createdAt      DateTime @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conta       ContaFinanceira      @relation(fields: [contaId], references: [id], onDelete: Cascade)
  lancamentos LancamentoBancario[]

  @@index([tenantId])
  @@index([contaId])
}

/// Linha do extrato bancário. `valor` tem sinal: entrada positiva, saída negativa.
model LancamentoBancario {
  id           Int      @id @default(autoincrement())
  tenantId     String
  contaId      Int
  importacaoId Int?
  data         String
  valor        Decimal  @db.Decimal(14, 2)
  descricao    String
  fitid        String?
  /// Evita importar duas vezes a mesma linha (fitid, ou data+valor+descrição+ordem)
  hash         String
  /// "pendente" | "conciliado" | "ignorado"
  status       String   @default("pendente")
  /// "extrato" | "manual"
  origem       String   @default("extrato")
  createdAt    DateTime @default(now())

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conta              ContaFinanceira      @relation(fields: [contaId], references: [id], onDelete: Cascade)
  importacao         ImportacaoExtrato?   @relation(fields: [importacaoId], references: [id], onDelete: SetNull)
  baixas             Baixa[]
  transferenciasDe   TransferenciaConta[] @relation("TransferenciaLancamentoDe")
  transferenciasPara TransferenciaConta[] @relation("TransferenciaLancamentoPara")

  @@unique([contaId, hash])
  @@index([tenantId, contaId, status])
}

model TransferenciaConta {
  id          Int      @id @default(autoincrement())
  tenantId    String
  deContaId   Int
  paraContaId Int
  data        String
  valor       Decimal  @db.Decimal(14, 2)
  obs         String?
  createdAt   DateTime @default(now())

  /// Linhas do extrato que confirmam a saída (conta de origem) e a entrada (conta de destino)
  lancamentoDeId   Int?
  lancamentoParaId Int?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deConta        ContaFinanceira     @relation("TransferenciaContaOrigem", fields: [deContaId], references: [id])
  paraConta      ContaFinanceira     @relation("TransferenciaContaDestino", fields: [paraContaId], references: [id])
  lancamentoDe   LancamentoBancario? @relation("TransferenciaLancamentoDe", fields: [lancamentoDeId], references: [id], onDelete: SetNull)
  lancamentoPara LancamentoBancario? @relation("TransferenciaLancamentoPara", fields: [lancamentoParaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// ─── Painel interno da equipe ─────────────────────────────────────────────────
// Mundo separado do cliente: login, token e permissões próprios (server/painel/). Nada aqui tem `tenantId` próprio.

model EquipeUsuario {
  id                Int       @id @default(autoincrement())
  nome              String
  email             String    @unique
  senha             String
  /// equipe_admin tem todas as permissões; os demais valem pelo que está em `permissoes`
  papel             String    @default("atendente")
  ativo             Boolean   @default(true)
  /// suporte, suporte_supervisor, clientes, clientes_editar, financeiro, equipe
  permissoes        String[]  @default([])
  trocarSenha       Boolean   @default(true)
  /// disponivel | ocupado | ausente (o sinal de presença vem do painel aberto)
  statusAtendimento String    @default("ausente")
  ultimoSinalEm     DateTime?
  setores           String[]  @default([])
  ultimoLoginEm     DateTime?
  createdAt         DateTime  @default(now())

  refreshTokens EquipeRefreshToken[]
  auditorias    AuditoriaEquipe[]
  atribuidos    Ticket[]             @relation("TicketAtribuido")
}

model EquipeRefreshToken {
  id        String   @id @default(cuid())
  equipeId  Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revogado  Boolean  @default(false)

  equipe EquipeUsuario @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([equipeId])
}

/// Toda ação da equipe. A auditoria do cliente (AuditLog) exige tenantId e não serve aqui.
model AuditoriaEquipe {
  id        Int      @id @default(autoincrement())
  equipeId  Int?
  acao      String
  alvoTipo  String?
  alvoId    String?
  tenantId  String?
  ticketId  Int?
  detalhe   String?
  ip        String?
  createdAt DateTime @default(now())

  equipe EquipeUsuario? @relation(fields: [equipeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([equipeId])
  @@index([tenantId])
}

/// Linha única (id 1): horário do chat e quantos chats cada atendente faz ao mesmo tempo.
model ConfigAtendimento {
  id         Int      @id @default(1)
  /// { "1": ["08:00","18:00"], ... } com 0 = domingo; dia ausente = sem chat
  horario    Json
  capacidade Int      @default(3)
  updatedAt  DateTime @updatedAt
}

// ─── Suporte: chamados (ticket) e chat ao vivo, na mesma fila ─────────────────

model Ticket {
  /// O número do chamado: global e na ordem de abertura (a "ordem de solicitação")
  id                   Int       @id @default(autoincrement())
  tenantId             String
  abertoPorId          Int?
  /// ticket | chat
  canal                String    @default("ticket")
  assunto              String
  /// Área do sistema onde está o problema (server/config/suporte.js)
  setor                String    @default("outro")
  /// baixa | normal | alta | urgente
  prioridade           String    @default("normal")
  /// "Isto me impede de trabalhar?" respondido pelo cliente
  bloqueante           Boolean   @default(false)
  /// na_fila | aberto | em_atendimento | aguardando_cliente | resolvido | fechado | abandonado
  status               String    @default("aberto")
  atribuidoId          Int?
  /// Chegada na fila (ordem de atendimento). Para ticket é a própria abertura.
  entrouNaFilaEm       DateTime  @default(now())
  iniciadoEm           DateTime?
  primeiraRespostaEm   DateTime?
  encerradoEm          DateTime?
  ultimoSinalClienteEm DateTime?
  ultimaMensagemEm     DateTime  @default(now())
  /// Mensagens da equipe que o cliente ainda não viu / do cliente que a equipe ainda não viu
  naoLidoCliente       Int       @default(0)
  naoLidoEquipe        Int       @default(0)
  avaliacao            Int?
  /// Plano do cliente quando abriu: define o prazo de resposta
  plano                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  abertoPor User?            @relation(fields: [abertoPorId], references: [id], onDelete: SetNull)
  atribuido EquipeUsuario?   @relation("TicketAtribuido", fields: [atribuidoId], references: [id], onDelete: SetNull)
  mensagens TicketMensagem[]
  anexos    TicketAnexo[]

  @@index([status, entrouNaFilaEm])
  @@index([tenantId, createdAt])
  @@index([atribuidoId])
}

model TicketMensagem {
  id             Int      @id @default(autoincrement())
  ticketId       Int
  tenantId       String
  /// cliente | equipe | sistema
  autorTipo      String
  autorUserId    Int?
  autorEquipeId  Int?
  /// Nome na hora do envio (a pessoa pode sair depois)
  autorNome      String?
  texto          String
  /// Nota interna: só a equipe vê. Nunca sai nas rotas do cliente.
  interna        Boolean  @default(false)
  /// app | chat | email
  origem         String   @default("app")
  /// Message-ID do e-mail que originou a mensagem (resposta recebida por e-mail): a mesma mensagem nunca entra duas vezes
  emailMessageId String?
  /// Mensagem da equipe enviada por e-mail ao cliente: enviado | falhou | sem_provedor | nao_enviado (nota interna, canal chat...)
  emailStatus    String?
  /// Id do e-mail no provedor (Resend), para conferir no painel deles
  emailId        String?
  createdAt      DateTime @default(now())

  ticket Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  anexos TicketAnexo[]

  @@unique([ticketId, emailMessageId])
  @@index([ticketId, id])
}

model TicketAnexo {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  mensagemId Int?
  tenantId   String
  nome       String
  mimeType   String
  tamanho    Int
  dados      Bytes
  createdAt  DateTime @default(now())

  ticket   Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  mensagem TicketMensagem? @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ─── Assinatura e cobranças (financeiro do painel da equipe) ──────────────────

/// A assinatura de uma empresa: quanto paga, quando vence e se é cortesia. Plano e ciclo moram em Tenant.
model Assinatura {
  id                  Int       @id @default(autoincrement())
  tenantId            String    @unique
  /// Valor de UM período (do ciclo da empresa: mensal = o mês; anual = o ano inteiro)
  valor               Decimal   @db.Decimal(14, 2)
  /// Dia do mês do vencimento (1 a 28)
  diaVencimento       Int       @default(10)
  /// Cortesia: não gera cobrança e não entra na receita recorrente
  cortesia            Boolean   @default(false)
  /// manual | o gateway que cobra esta empresa
  gateway             String    @default("manual")
  gatewayClienteId    String?
  gatewayAssinaturaId String?
  ativadaEm           DateTime?
  canceladaEm         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([gateway, gatewayClienteId])
}

/// Uma cobrança (fatura). Em aberto vira "atrasada" só pela data: a situação nunca é gravada.
model Cobranca {
  id                 Int      @id @default(autoincrement())
  tenantId           String
  /// AAAA-MM do mês a que se refere (no anual, o mês em que o ano começa). Única por empresa: gerar duas vezes não duplica.
  referencia         String
  descricao          String
  /// Snapshot de quando foi gerada
  plano              String
  ciclo              String   @default("mensal")
  valor              Decimal  @db.Decimal(14, 2)
  /// AAAA-MM-DD, fuso de São Paulo
  vencimento         String
  /// aberta | paga | cancelada
  status             String   @default("aberta")
  /// AAAA-MM-DD do pagamento
  pagaEm             String?
  valorPago          Decimal? @db.Decimal(14, 2)
  /// pix | boleto | cartao | transferencia | outro
  forma              String?
  gateway            String   @default("manual")
  gatewayId          String?
  linkPagamento      String?
  motivoCancelamento String?
  registradaPorId    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, referencia])
  /// A fatura do gateway (invoice do Stripe) vira no máximo uma cobrança
  @@unique([gateway, gatewayId])
  @@index([status, vencimento])
  @@index([gateway, gatewayId])
}

/// Evento recebido de um gateway de pagamento. A chave (gateway, eventoId) garante que o mesmo aviso, reenviado, não seja aplicado duas vezes.
model EventoPagamento {
  id         Int      @id @default(autoincrement())
  gateway    String
  eventoId   String
  tipo       String
  resultado  String?
  /// O corpo recebido, para conferência
  payload    Json?
  recebidoEm DateTime @default(now())

  @@unique([gateway, eventoId])
}

/// Aviso recebido de um provedor de e-mail (Resend). A chave (provedor, eventoId) garante que o mesmo aviso, reenviado, não vire duas mensagens.
model EventoEmail {
  id         Int      @id @default(autoincrement())
  provedor   String
  eventoId   String
  tipo       String
  resultado  String?
  recebidoEm DateTime @default(now())

  @@unique([provedor, eventoId])
}
